{
  "name": "docflow-web",
  "version": "1.0.0",
  "private": true,
  "description": "Интерфейс системы документооборота и согласования UTECH",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config.ts --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts --mode demo",
    "preview": "vite preview"
