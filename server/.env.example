# Строка подключения к PostgreSQL 16
DATABASE_URL=postgres://docflow:docflow@127.0.0.1:5432/docflow
# Порт и адрес HTTP-сервера
PORT=3000
HOST=0.0.0.0
# Каталог хранения загруженных файлов (должен входить в резервную копию)
FILES_DIR=./data/files
# Внешний адрес системы — используется в ссылках на карточки, передаваемых в Битрикс24
PUBLIC_URL=http://localhost:3000
# Интеграция с Битрикс24: mock — встроенный эмулятор, rest — входящий вебхук REST API
BITRIX_MODE=mock
# Адрес входящего вебхука, например https://portal.example.ru/rest/1/xxxxxxxxxxxx/ (секрет, только здесь)
BITRIX_WEBHOOK_URL=
# Адрес портала для ссылок на сделки, например https://portal.example.ru
BITRIX_PORTAL_URL=
# Идентификатор пользователя Битрикс24 — ответственного за создаваемые задачи согласований
BITRIX_RESPONSIBLE_ID=1
# Таймаут запросов к Битрикс24, мс
BITRIX_TIMEOUT_MS=10000
# Ограничения файлов
MAX_FILE_MB=50
MAX_FILES_PER_CARD=20
MAX_CARD_TOTAL_MB=200
ALLOWED_EXTENSIONS=xlsx,xls,docx,doc,pdf,jpg,jpeg,png
# Срок сессии, часов бездействия
SESSION_TTL_HOURS=12
# true — cookie сессии только по HTTPS (включать за обратным прокси с HTTPS)
COOKIE_SECURE=false
# true — доверять заголовкам X-Forwarded-* обратного прокси
TRUST_PROXY=false
# Фоновые задания (синхронизация с Битрикс24, сроки, очистка сессий)
JOBS_ENABLED=true
# Пароль тестовых учётных записей, создаваемых командой npm run seed
SEED_PASSWORD=Test12345!
# Каталог собранного интерфейса (по умолчанию ../web/dist относительно server/)
# WEB_DIST=
# Часовой пояс для «конца дня» в сроках
TZ=Europe/Moscow
