# Настройки системы документооборота для docker-compose.yml.
# Скопируйте в deploy/.env и заполните. Файл .env содержит секреты: права 600, в git не добавляется.
# Копия .env сохраняется в каждой резервной копии (deploy/backup.sh).

# ── База данных ──
POSTGRES_DB=docflow
POSTGRES_USER=docflow
# Только буквы, цифры, «-», «_», «.» (подставляется в строку подключения без кодирования).
POSTGRES_PASSWORD=change-me-strong-password
# Порт PostgreSQL на локальном интерфейсе сервера (для резервного копирования с сервера).
DB_PORT=5432

# ── Приложение ──
APP_PORT=3000
# Внешний адрес системы: используется в ссылках из Битрикс24 и уведомлений.
PUBLIC_URL=https://docflow.example.local
# Работа за обратным прокси с HTTPS:
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
LOG_LEVEL=info
TZ=Europe/Moscow

# ── Файлы ──
MAX_FILE_MB=50
MAX_FILES_PER_CARD=20
MAX_CARD_TOTAL_MB=200
ALLOWED_EXTENSIONS=xlsx,xls,docx,doc,pdf,jpg,jpeg,png

# ── Битрикс24 ──
# mock — встроенный эмулятор (стенд для приёмки); rest — входящий вебхук портала.
BITRIX_MODE=mock
# Входящий вебхук: https://<портал>/rest/<id пользователя>/<токен>/  (секрет)
BITRIX_WEBHOOK_URL=
BITRIX_PORTAL_URL=https://bitrix24.example.local
BITRIX_RESPONSIBLE_ID=1
BITRIX_TIMEOUT_MS=10000

# ── Начальные данные (только тестовая модель) ──
SEED_PASSWORD=Test12345!
