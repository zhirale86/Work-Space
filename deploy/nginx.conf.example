# Пример обратного прокси nginx с HTTPS для системы документооборота.
# Скопируйте в /etc/nginx/conf.d/docflow.conf, замените имя сервера и пути к сертификатам,
# проверьте: nginx -t && systemctl reload nginx.
# В deploy/.env при этом: PUBLIC_URL=https://docflow.example.local, TRUST_PROXY=true, COOKIE_SECURE=true.

upstream docflow_app {
    # Приложение из docker-compose.yml слушает только локальный интерфейс.
    server 127.0.0.1:3000;
    keepalive 16;
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name docflow.example.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name docflow.example.local;

    # Сертификат внутреннего удостоверяющего центра компании.
    ssl_certificate     /etc/nginx/ssl/docflow.crt;
    ssl_certificate_key /etc/nginx/ssl/docflow.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:docflow_ssl:10m;
    ssl_session_timeout 1d;

    # Не меньше MAX_FILE_MB (50 МБ) с запасом на служебную часть multipart.
    client_max_body_size 55m;
    client_body_timeout 120s;

    # Заголовки безопасности (HSTS) приложение выставляет само при COOKIE_SECURE=true.
    server_tokens off;

    access_log /var/log/nginx/docflow.access.log;
    error_log  /var/log/nginx/docflow.error.log;

    location / {
        proxy_pass http://docflow_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Загрузка крупных файлов передаётся приложению потоком, без буферизации на диске прокси.
        proxy_request_buffering off;
    }
}
